{
  "name": "typelang",
  "version": "1.2.5",
  "description": "The fast Calculator Alpha Version with Basic and Haskell functions",
  "main": "type/dist/tls.js",
  "bin": {
    "tls": "type/dist/tls.js"
  },
  "scripts": {
    "build": "tsc",
    "pkg": "npm run build; npm run pkg:win; npm run pkg:linux; npm run pkg:mac",
    "pkg:win": "pkg type/dist/tls.js --targets node18-win-x64 --output windows/typelang.exe",
    "pkg:linux": "pkg type/dist/tls.js --targets node18-linux-x64 --output linux/typelang",
    "pkg:mac": "pkg type/dist/tls.js --targets node18-macos-x64 --output macos/typelang",
    "test": "node type/dist/tls.js",
    "start": "node type/dist/tls.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LegendCoderDev505/TypeLang.git"
  },
  "keywords": ["calculator", "typescript", "haskell", "alpha", "typelang"],
  "author": "Legend Coder Dev 505",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LegendCoderDev505/TypeLang/issues"
  },
  "homepage": "https://github.com/LegendCoderDev505/TypeLang#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "pkg": "^5.8.0",
    "typescript": "^5.8.3"
  },
  "pkg": {
    "scripts": {
      "start": "node type/dist/tls.js"
    },
    "targets": [
      "node14-linux-x64",
      "node14-win-x64",
      "node14-macos-x64"
    ]
  }
}
